    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "eslint-config-prettier": "10.1.8",
    "playwright": "^1.63.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
